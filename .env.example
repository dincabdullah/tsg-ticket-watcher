# SADECE YEREL DENEME ICIN.
# Bu dosyayi ".env" adiyla kopyala ve kendi degerlerini yaz.
# .env dosyasi .gitignore'da -- GitHub'a ASLA gitmez, gitmemeli.
# GitHub Actions bu dosyayi kullanmaz; orada degerler repo Secrets'tan gelir.

# @BotFather'in verdigi token. Bicim: rakamlar + ":" + ~35 karakter
TELEGRAM_BOT_TOKEN=8123456789:AAF3xQ_bu_kisim_seninkiyle_degisecek

# Duz sayi. Bota /start yazdiktan sonra
# https://api.telegram.org/bot<TOKEN>/getUpdates adresinden al.
# Grup ise basinda "-100..." olur.
TELEGRAM_CHAT_ID=123456789

# Istege bagli -- bos birakirsan varsayilanlar kullanilir.
